<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>SpineViewer Android</ApplicationTitle>
    <ApplicationId>com.spineviewer.android</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <ApplicationIdGuid>8D3575E7-10A2-4EA2-93B0-A7D5F4F4A9C0</ApplicationIdGuid>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../SpineViewer.Core/SpineViewer.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../SpineViewer.Runtime42/SpineViewer.Runtime42.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../SpineViewer.Runtime41/SpineViewer.Runtime41.csproj" /></ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="Platforms/Android/Assets/vulkan/*.spv" Link="vulkan/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="Platforms/Android/jniLibs/arm64-v8a/libspine_vulkan.so" Abi="arm64-v8a" Condition="Exists('Platforms/Android/jniLibs/arm64-v8a/libspine_vulkan.so')" />
  </ItemGroup>
</Project>